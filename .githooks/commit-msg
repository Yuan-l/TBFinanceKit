#!/usr/bin/env python3
"""
commit-msg 钩子：校验Commit Message格式，并可检查变更内容。
放置在 .git/hooks/commit-msg，并赋予可执行权限。
"""

import sys
import re
import subprocess
from pathlib import Path

# -------------------- 配置 --------------------
# Commit Message 正则（Conventional Commits 基本版）
COMMIT_MSG_PATTERN = re.compile(
    r'^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([\w\-]+\))?!?: .{1,50}$'
)

# 禁止修改的文件列表（例如某些敏感配置文件）
FORBIDDEN_FILES = ['Debug.xcconfig']

# 禁止包含的调试关键字（出现在变更行中；仅对 OC/Swift 文件生效，见 DEBUG_CHECK_EXTENSIONS）
DEBUG_KEYWORDS = ['NSLog', 'debugger', 'console.log']

# 配置部分
CLASS_NAME_PATTERN = re.compile(r'^(TB|LM|My)[A-Za-z0-9_]*$')
# COMPONENT_MAP = { ... }          # 路径前缀 -> 组件名
COMPONENTS_TO_CHECK = {'MyCameraModule', 'TBLanguageModule', 'TBCustomNetworkLogger', 'LMPerformanceKit', 'MyOpenWeatherPlus', 'TBCustomGitHook', 'TBCustomFlutter', 'TBTigerBaseFlutter', 'TBCustomUIKit', 'TBCustomHomePage'}  # 需要检查的组件

# 新增 Swift / Objective-C 文件名前缀白名单（区分大小写）
REQUIRED_FILE_PREFIXES = ('TB', 'LM', 'My')
SOURCE_FILE_EXTENSIONS = ('.swift', '.h', '.m', '.mm')

# 辅助函数
def get_component_name(file_path):
    # 在主工程提交时路径包含 components/<模块>；
    # 在模块仓库内提交时只有相对路径，所以用绝对路径判断组件
    parts = Path(file_path).resolve().parts
    for comp in sorted(COMPONENTS_TO_CHECK):
        if comp in parts:          # 目录段完全相等，不是子串
            return comp
    return None

def get_new_class_names_in_file(file_path):
    # 获取diff新增行并解析
    changes = get_file_diff_lines(file_path)  # 假设已有该函数
    added_lines = [ch['content'] for ch in changes]
    return extract_class_names_from_lines(added_lines, Path(file_path).suffix)

def is_generated_file(file_path):
    """CocoaPods 生成的支撑文件不是业务代码：dummy 类名由工具生成，
    不应参与 TB 前缀检查（否则主工程提交 Pods 变更会被误拦）"""
    path = Path(file_path)
    return "Pods" in path.resolve().parts or path.name.endswith("-dummy.m")

def check_class_names(files):
    errors = []
    for f in files:
        if is_generated_file(f):
            continue
        comp = get_component_name(f)
        if comp not in COMPONENTS_TO_CHECK:
            continue
        new_classes = get_new_class_names_in_file(f)
        for cls in new_classes:
            if not CLASS_NAME_PATTERN.match(cls):
                errors.append(f"文件 {f} 中新增类名 '{cls}' 不符合规范")
    if errors:
        print("\n".join(errors))
        sys.exit(1)

def extract_class_names_from_lines(lines, file_extension):
    """
    从新增的行列表中提取类名。
    lines: 字符串列表，每行内容（已去除开头的 '+'）
    file_extension: 文件扩展名，如 '.swift', '.m', '.h'
    返回类名列表
    """
    class_names = []
    if file_extension in ('.swift'):
        # Swift 类定义：class 类名: 或 class 类名 { 或 class 类名<...>:
        # 可同时匹配 struct, protocol, enum
        patterns = [
            r'^\s*(final\s+)?class\s+([A-Za-z_][A-Za-z0-9_]*)[:\s{]',
            r'^\s*struct\s+([A-Za-z_][A-Za-z0-9_]*)[:\s{]',
            r'^\s*protocol\s+([A-Za-z_][A-Za-z0-9_]*)[:\s{]',
            r'^\s*enum\s+([A-Za-z_][A-Za-z0-9_]*)[:\s{]'
        ]
        for line in lines:
            for pat in patterns:
                m = re.search(pat, line)
                if m:
                    class_names.append(m.group(2) if 'final' in pat else m.group(1))
                    break
    elif file_extension in ('.h', '.m', '.mm'):
        # Objective-C 类定义：@interface ClassName : ... 或 @implementation ClassName
        patterns = [
            r'^\s*@interface\s+([A-Za-z_][A-Za-z0-9_]*)\s*(?::|\(|\s*$)',
            r'^\s*@implementation\s+([A-Za-z_][A-Za-z0-9_]*)'
        ]
        for line in lines:
            for pat in patterns:
                m = re.search(pat, line)
                if m:
                    class_names.append(m.group(1))
                    break
    return class_names

# -------------------- 辅助函数 --------------------
def get_staged_files():
    """返回暂存区中所有变更文件的列表"""
    result = subprocess.run(
        ['git', 'diff', '--cached', '--name-only'],
        capture_output=True, text=True, check=True
    )
    return [f for f in result.stdout.splitlines() if f]

def get_added_files():
    """返回暂存区中新增的文件列表（不包含修改和重命名）"""
    result = subprocess.run(
        ['git', 'diff', '--cached', '--name-only', '--diff-filter=A', '--no-color'],
        capture_output=True, text=True, check=True
    )
    return [f for f in result.stdout.splitlines() if f]

def check_new_file_names(files):
    """新增的 Swift / Objective-C 文件名必须以指定前缀开头"""
    errors = []
    for f in files:
        if is_generated_file(f):
            continue
        path = Path(f)
        if path.suffix.lower() not in SOURCE_FILE_EXTENSIONS:
            continue
        if not path.stem.startswith(REQUIRED_FILE_PREFIXES):
            errors.append(
                f"新增文件 {f} 命名不符合规范："
                f"Swift/OC 文件名需以 {'、'.join(REQUIRED_FILE_PREFIXES)} 开头"
            )
    if errors:
        print("\n".join(errors))
        sys.exit(1)

def get_file_diff_lines(file_path):
    """
    返回指定文件在暂存区中的变更行号列表（每行为一个字典，包含行号和内容）
    例如：[{'line': 10, 'content': 'let x = 1'}, ...]
    """
    # 使用 unified=0 使输出紧凑，易于解析
    result = subprocess.run(
        ['git', 'diff', '--cached', '--unified=0', '--no-color', '--', file_path],
        capture_output=True, text=True, check=False
    )
    if result.returncode != 0:
        return []  # 文件可能已被删除等

    diff_lines = result.stdout.splitlines()
    changes = []
    current_line_num = None
    in_hunk = False

    # 解析diff输出，提取新增或修改的行（以+开头）
    for line in diff_lines:
        # 匹配hunk header：@@ -旧起始,旧行数 +新起始,新行数 @@
        hunk_match = re.match(r'^@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@', line)
        if hunk_match:
            current_line_num = int(hunk_match.group(1))
            in_hunk = True
            continue

        # 文件头等元信息（diff --git / index / --- / +++）不在 hunk 内，直接跳过
        if not in_hunk:
            continue

        # 如果是新增行（+开头，非+++）
        if line.startswith('+') and not line.startswith('+++'):
            content = line[1:]  # 去掉开头的+
            changes.append({'line': current_line_num, 'content': content})
            current_line_num += 1
        elif line.startswith('-'):
            # 删除行不会增加新文件的行号
            pass
        elif line.startswith('\\'):  # 忽略 \ No newline at end of file
            pass
        else:
            # unified=0 模式下理论上不应有上下文行，兜底维护行号
            current_line_num += 1

    return changes

def check_commit_message(msg_file):
    """校验Commit Message格式，不符合则退出（只校验首行 subject）"""
    with open(msg_file, 'r', encoding='utf-8') as f:
        msg = f.read().strip()

    subject = msg.splitlines()[0] if msg else ""

    if not COMMIT_MSG_PATTERN.match(subject):
        print("❌ Commit Message 格式不符合规范！")
        print("   应形如：type(scope): subject（首行）")
        print("   type 可选: build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test")
        sys.exit(1)

    print("✅ Commit Message 格式校验通过")

def check_forbidden_files(files):
    """检查是否有禁止修改的文件被提交"""
    forbidden = [f for f in files if f in FORBIDDEN_FILES]
    if forbidden:
        print("❌ 以下文件禁止直接提交：", ', '.join(forbidden))
        sys.exit(1)

# 调试关键字检查仅适用的文件扩展名（Python/Shell 等脚本的 print 是正当输出，不检查）
DEBUG_CHECK_EXTENSIONS = ('.swift', '.h', '.m', '.mm')

def check_debug_keywords(files):
    """检查变更行中是否包含调试关键字（仅 OC/Swift 源码文件）"""
    has_debug = False
    for file in files:
        if is_generated_file(file):
            continue
        if Path(file).suffix.lower() not in DEBUG_CHECK_EXTENSIONS:
            continue
        changes = get_file_diff_lines(file)
        for change in changes:
            for kw in DEBUG_KEYWORDS:
                if kw in change['content']:
                    print(f"❌ 文件 {file}:{change['line']} 包含调试代码 '{kw}'")
                    has_debug = True
    if has_debug:
        sys.exit(1)

# -------------------- 主逻辑 --------------------
def main():
    # 参数：保存Commit Message的临时文件路径
    if len(sys.argv) < 2:
        print("❌ 缺少commit message文件参数")
        sys.exit(1)
    msg_file = sys.argv[1]

    # 1. 校验Commit Message格式
    check_commit_message(msg_file)

    # 2. 获取本次提交的所有变更文件
    staged_files = get_staged_files()
    if not staged_files:
        # 空提交（如只修改了文件但未暂存），直接通过
        sys.exit(0)

    check_class_names(staged_files)

    # 3. 检查新增 Swift/OC 文件的命名前缀
    check_new_file_names(get_added_files())

    # 4. 检查禁止文件
    check_forbidden_files(staged_files)

    # 5. 检查调试关键字
    check_debug_keywords(staged_files)

    print("✅ 所有检查通过")
    sys.exit(0)

if __name__ == '__main__':
    main()

# installed by scripts/install_hooks.py
